;---------------DELAY routines--------------------
del_n_msec:    ; delay  msec10x_n x 10 miliseconds
                CALL    del_10ms
                SUB     msec10x_n, 01
                JUMP    NZ, del_n_msec
                RETURN


del_10ms:       LOAD    sC, 32
del_10mslp:
                CALL    del_200us
                SUB     sC, 01
                JUMP    NZ, del_10mslp
                RETURN

del_200us:      LOAD    sB, C8
del_200uslp:
                CALL    del_1us
                SUB     sB, 01
                JUMP    NZ, del_200uslp
                RETURN

del_1us:        LOAD      sA, 0B
del_1uslp:      SUB       sA, 01
                JUMP      NZ, del_1uslp
                RETURN

del_220ns:      LOAD      sA, 03
                SUB       sA, 01
                SUB       sA, 01
                SUB       sA, 01
                RETURN
