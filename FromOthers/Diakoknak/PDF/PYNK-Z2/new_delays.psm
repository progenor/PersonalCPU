del_10ms:       LOAD    sC, 32
del_10mslp:
                CALL    del_200us
                SUB     sC, 01
                JUMP    NZ, del_10mslp
                RETURN
				
del_1520us:		LOAD sC,08
del_1520uslp:	
				CALL del_200us
				SUB sC, 01
				JUMP    NZ, del_1520uslp
                RETURN
				
				
del_200us:      LOAD    sB, C8
del_200uslp:
                CALL    del_1us
                SUB     sB, 01
                JUMP    NZ, del_200uslp
                RETURN				
				
				
				
				
del_37us:       LOAD    sB, 25
